        anpas: anpas {
            compatible = "zmk,behavior-mod-morph";
            label = "ANPAS";
            bindings = <&anp>, <&aster>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
        };

        uspl: uspl {
            compatible = "zmk,behavior-mod-morph";
            label = "USPL";
            bindings = <&us>, <&pl>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
