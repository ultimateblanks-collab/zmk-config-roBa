    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&L_HRM LWIN Q     &L_HRM LEFT_ALT W  &L_HRM LCTRL E  &L_HRM LSHFT R        &kp T                                   &kp Y           &R_HRM RSHFT U  &R_HRM RCTRL I  &R_HRM RIGHT_ALT O  &R_HRM RWIN P
&kp A             &kp S              &kp D           &kp F                 &kp G              &ctrlW      &menuTD  &kp H           &kp J           &kp K           &kp L               &mkp MB1
&mt LEFT_SHIFT Z  &kp X              &kp C           &kp V                 &kp B              &ctrlT      &prscTD  &kp N           &kp M           &comHI          &perUS              &THUMB_MO 5 ENTER
&kp TAB           &kp PG_UP          &kp PAGE_DOWN   &THUMB_MO 4 LEFT_ALT  &THUMB_MO 6 LCTRL  &sqCOR      &dqSEMI  &RT_SP 2 SPACE                                                      &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        MB {
            bindings = <
&kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none                       &none     &none     &none  &none        &none
&none     &none         &none      &none      &none  &none      &none     &none     &mkp MB1  &none  &SPL5 5 MB2  &none
&none     &none         &none      &none      &none  &none      &none     &none     &none     &none  &none        &none
&none     &none         &none      &none      &none  &none      &mkp MB5  &mkp MB4                                &none
            >;
        };

        BASIC {
            bindings = <
&kp LWIN    &SP_CTPGUP LEFT_ALT 0  &SP_CTUP LCTRL 0  &SP_CTPGDN LSHFT 0  &none                        &altesc   &kp BSPC  &kp UP    &kp ESC    &saltesc
&shiftHOME  &ctrlLEFT              &ctrlDOWN         &ctrlRIGHT          &shiftEND  &none      &none  &wintab   &kp LEFT  &kp DOWN  &kp RIGHT  &pl
&none       &ctHOME                &none             &ctEND              &none      &none      &none  &kp RWIN  &kp HOME  &kp DEL   &kp END    &kp SLASH
&none       &none                  &none             &none               &none      &none      &none  &none                                    &none
            >;
        };

        NUMFUN {
            bindings = <
&kp F1   &kp F2  &kp F3   &kp F4  &kp F5                          &kp F6  &kp F7     &kp F8  &kp F9     &kp F10
&kp N1   &kp N2  &kp N3   &kp N4  &kp N5  &altf11        &kp F12  &kp N6  &kp N7     &kp N8  &kp N9     &kp N0
&kp DOT  &carte  &evalue  &none   &none   &kp EQUAL      &eql     &plus   &kp MINUS  &aster  &kp SLASH  &none
&altf11  &none   &none    &none   &none   &none          &none    &none                                 &kp F12
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        SYMBOL {
            bindings = <
&none  &none  &none  &none  &none                    &kp INTERNATIONAL_3  &kp LEFT_BRACKET  &kp RBKT  &kp NUHS  &kp EQUAL
&none  &none  &none  &none  &none  &none      &none  &dollar              &anp              &l_kakko  &r_kakko  &eql
&none  &none  &none  &none  &none  &none      &none  &none                &hush             &Lmid     &Rmid     &exc
&none  &none  &none  &none  &none  &none      &none  &none                                                      &none
            >;
        };

        SCROLL {
            bindings = <
&none  &none  &none  &none  &none                       &none    &none     &none     &none  &none
&none  &none  &none  &none  &none  &none      &none     &none    &mkp MB4  &mkp MB5  &none  &none
&none  &none  &none  &none  &none  &none      &none     &none    &none     &none     &none  &none
&none  &none  &none  &none  &none  &none      &kp HOME  &kp END                             &none
            >;
        };

        layer_6 {
            bindings = <
&none    &kp F1  &kp F2  &kp F3  &none                      &plus    &kp N1  &kp N2  &kp N3  &kp MINUS
&kp F10  &kp F4  &kp F5  &kp F6  &kp F11  &none      &none  &kp DOT  &kp N4  &kp N5  &kp N6  &kp N0
&kp F12  &kp F7  &kp F8  &kp F9  &none    &none      &none  &aster   &kp N7  &kp N8  &kp N9  &kp SLASH
&none    &none   &none   &none   &none    &none      &none  &none                            &none
            >;
        };
    };
};
