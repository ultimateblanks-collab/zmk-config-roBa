            label = "WINTAB";
        };

        winshiftS: winshiftS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp LSHFT>,
                <&macro_wait_time 20>,
                <&kp S>,
