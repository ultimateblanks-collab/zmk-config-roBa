        USPL_L5: USPL_L5 {
            compatible = "zmk,behavior-hold-tap";
            label = "USPL_L5";
            bindings = <&mo>, <&uspl>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <18 17 19 20>;
        };

        MINUS_L5: MINUS_L5 {
            compatible = "zmk,behavior-hold-tap";
            label = "MINUS_L5";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <17 18 19 20 7 41 40>;
        };

        SLSP_1: SLSP_1 {
            compatible = "zmk,behavior-hold-tap";
            label = "SLSP_1";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
        };

        mius: mius {
            compatible = "zmk,behavior-tap-dance";
            label = "MIUS";
            #binding-cells = <0>;
            bindings = <&AML_LS 4 MINUS>, <&us>;
        };

        cosq: cosq {
            compatible = "zmk,behavior-tap-dance";
            label = "COSQ";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&sq>;
        };

        perdq: perdq {
            compatible = "zmk,behavior-tap-dance";
            label = "PERDQ";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&dq>;
        };

        SL_SP3: SL_SP3 {
            compatible = "zmk,behavior-hold-tap";
            label = "SL_SP3";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&L_HRM LWIN Q  &L_HRM LALT W  &L_HRM LCTRL E  &L_HRM LSHFT R       &kp T                                                                   &kp Y                 &R_HRM RSHFT U  &R_HRM RCTRL I  &R_HRM RIGHT_ALT O  &R_HRM RWIN P
&kp A          &kp S          &kp D           &kp F                &kp G             &athutt                       &kp K_CONTEXT_MENU      &kp H                 &AML_LS 3 J     &MLSP 1 K       &AML_LS 2 L         &mius
&kp Z          &kp X          &kp C           &kp V                &kp B             &hussexc                      &kp PRINTSCREEN         &kp N                 &kp M           &cosq           &perdq              &kp ENTER
&anpas         &kp PG_UP      &kp PAGE_DOWN   &L_THUMB 3 LEFT_ALT  &L_THUMB 4 LCTRL  &L_HRM LEFT_SHIFT DELETE      &R_HRM RIGHT_SHIFT TAB  &L_THUMB 2 BACKSPACE                                                      &kp SLASH
            >;

            sensor-bindings = <&inc_dec_kp A B>;
        };

        MOUSE {
            bindings = <
&none     &kp LALT    &kp LCTRL        &kp LSHFT           &none                           &none     &none     &none  &none          &none
&altprsc  &winshiftS  &kp PRINTSCREEN  &kp K_CONTEXT_MENU  &none  &kp LCTRL      &none     &kp HOME  &mkp MB1  &none  &SL_SP3 2 MB2  &kp END
&none     &none       &none            &none               &none  &kp LSHFT      &none     &none     &none     &none  &none          &none
&none     &none       &none            &none               &none  &none          &mkp MB5  &mkp MB4                                  &none
            >;
        };

        ARROW {
            bindings = <
&L_HRM LWIN SEMI  &L_HRM LEFT_ALT APOSTROPHE  &L_HRM LCTRL RBKT  &L_HRM LSHFT NUHS  &anp                        &C_W       &ctpgup   &kp UP_ARROW    &ctpgdn    &none
&dq               &sq                         &lk                &rk                &aster    &none      &none  &sk LSHFT  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp GRAVE
&us               &pl                         &syounari          &dainari           &percent  &none      &none  &none      &altesc   &none           &saltesc   &wintab
&dollar           &kp INTERNATIONAL_3         &kp SLASH          &smaller           &larger   &none      &none  &none                                           &none
            >;
        };

        NUM {
            bindings = <
&L_HRM LWIN F1  &L_HRM LALT F2  &L_HRM LCTRL F3  &L_HRM LSHFT F4  &kp F5                    &kp F6         &kp F7  &kp F8     &kp F9      &kp F10
&kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3     &kp NUMBER_4     &kp N5  &none      &none  &kp NUMBER_6   &kp N7  &kp N8     &kp N9      &kp N0
&kp F11         &kp F12         &aster           &kp SLASH        &none   &none      &none  &kp BACKSPACE  &plus   &kp MINUS  &kp PERIOD  &kp ENTER
&none           &none           &none            &none            &none   &none      &none  &kp SPACE                                     &none
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        FUNC {
            bindings = <
&kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none                       &none    &kp RSHFT  &kp RCTRL  &kp RIGHT_ALT  &kp RWIN
&kp F1        &kp F2        &kp F3     &kp F4     &kp F5  &none      &none    &kp F6   &kp F7     &kp F8     &kp F9         &kp F10
&none         &none         &none      &none      &none   &none      &none    &kp F11  &kp F12    &kp F13    &kp F14        &kp F15
&none         &none         &none      &none      &none   &none      &evalue  &calte                                        &none
            >;
        };

        SNIPE {
            bindings = <
&kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none                       &none          &altesc    &kp HOME  &saltesc  &none
&none     &kp END       &none      &kp HOME   &none  &none      &none     &kp BACKSPACE  &kp ENTER  &kp TAB   &stab     &kp DEL
&none     &none         &none      &none      &none  &none      &none     &none          &altesc    &kp END   &saltesc  &none
&none     &none         &none      &none      &none  &none      &saltesc  &altesc                                       &none
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans        &trans        &trans        &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &none   &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans  &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
