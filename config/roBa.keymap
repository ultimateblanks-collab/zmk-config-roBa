            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp MINUS &kp LCTRL>;

            label = "CTRLMINUS";
        };

        ctrlUP: ctrlUP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp UP_ARROW>,
