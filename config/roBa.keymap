#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

//&mkp_input_listener { input-processors = <&zip_temp_layer 1 350>; };

&trackball {
    //  automouse-layer = <4>;
    //  scroll-layers = <5>;

    arrows {
        layers = <3>;
        bindings =
            <&kp RIGHT_ARROW>,
            <&kp LEFT_ARROW>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;

        tick = <100>;
        wait-ms = <5>;
        tap-ms = <5>;
    };

    arrows2 {
        layers = <4>;
        bindings = <&ctpgdn>, <&ctpgup>, <&saltesc>, <&altesc>;

        tick = <100>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

&inc_dec_kp {
};

/ {
    combos {
        compatible = "zmk,combos";

        end {
            bindings = <&kp END>;
            key-positions = <19 20>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <7 8>;
        };

        input {
            bindings = <&kp GRAVE>;
            key-positions = <18 13>;
        };

        VBE {
            bindings = <&VBE>;
            key-positions = <25 26>;
        };

        altf4 {
            bindings = <&endapp>;
            key-positions = <18 41>;
        };

        cw {
            bindings = <&C_W>;
            key-positions = <12 11 13>;
        };

        pageup {
            bindings = <&kp PG_UP>;
            key-positions = <2 3>;
        };

        pagedown {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <13 12>;
        };

        mns {
            bindings = <&kp MINUS>;
            key-positions = <11 12>;
        };

        pls {
            bindings = <&plus>;
            key-positions = <1 2>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <18 19>;
        };
    };

    macros {
        exc: exc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N1>,
                <&macro_release>,
                <&kp N1 &kp LEFT_SHIFT>;

            label = "EXC";
        };

        dq: dq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N2>,
                <&macro_release>,
                <&kp N2 &kp LEFT_SHIFT>;

            label = "DQ";
        };

        hush: hush {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N3>,
                <&macro_release>,
                <&kp N3 &kp LEFT_SHIFT>;

            label = "HUSH";
        };

        dollar: dollar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N4>,
                <&macro_release>,
                <&kp N4 &kp LEFT_SHIFT>;

            label = "DOLLAR";
        };

        percent: percent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N5>,
                <&macro_release>,
                <&kp N5 &kp LEFT_SHIFT>;

            label = "PERCENT";
        };

        anp: anp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N6>,
                <&macro_release>,
                <&kp N6 &kp LEFT_SHIFT>;

            label = "ANP";
        };

        sq: sq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N7>,
                <&macro_release>,
                <&kp N7 &kp LEFT_SHIFT>;

            label = "SQ";
        };

        lk: lk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N8>,
                <&macro_release>,
                <&kp N8 &kp LEFT_SHIFT>;

            label = "lk";
        };

        rk: rk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp N9>,
                <&macro_release>,
                <&kp N9 &kp LEFT_SHIFT>;

            label = "RK";
        };

        us: us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp INT_RO>,
                <&macro_release>,
                <&kp INT_RO &kp LEFT_SHIFT>;

            label = "US";
        };

        pl: pl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RSHFT>,
                <&macro_wait_time 50>,
                <&kp INT3>,
                <&macro_release>,
                <&kp INT3 &kp RSHFT>;

            label = "PL";
        };

        eql: eql {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp MINUS &kp LEFT_SHIFT>;

            label = "EQL";
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp EQUAL>,
                <&macro_release>,
                <&kp EQUAL &kp LEFT_SHIFT>;

            label = "TILDE";
        };

        plus: plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LEFT_SHIFT>;

            label = "PLUS";
        };

        aster: aster {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp SINGLE_QUOTE>,
                <&macro_release>,
                <&kp SINGLE_QUOTE &kp LEFT_SHIFT>;

            label = "ASTER";
        };

        endapp: endapp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 50>,
                <&kp F4>,
                <&macro_release>,
                <&kp F4 &kp LEFT_ALT>;

            label = "ENDAPP";
        };

        calte: calte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp N7 &kp N0 &kp N8 &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp N1 &kp N2 &kp N3 &kp ENTER>;
            label = "CALTE";
        };

        evalue: evalue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp N7 &kp N0 &kp N8 &kp TAB &kp N0 &kp N8 &kp N6 &kp N2 &kp ENTER>;
            label = "EVALUE";
        };

        ctpgup: ctpgup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 20>,
                <&kp PG_UP>,
                <&macro_release>,
                <&kp PG_UP &kp LCTRL>;

            label = "CTPGUP";
        };

        ctpgdn: ctpgdn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 20>,
                <&kp PG_DN>,
                <&macro_release>,
                <&kp PG_DN &kp LCTRL>;

            label = "CTPGDN";
        };

        VBE: VBE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 50>,
                <&kp F11>,
                <&macro_release>,
                <&kp F11 &kp LEFT_ALT>;

            label = "VBE";
        };

        prompt: prompt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_wait_time 50>,
                <&kp R>,
                <&macro_release>,
                <&kp R &kp LEFT_WIN>;

            label = "PROMPT";
        };

        ctrl_t: ctrl_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp T>,
                <&macro_release>,
                <&kp T &kp LCTRL>;

            label = "CTRL_T";
        };

        ctrl_w: ctrl_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp W>,
                <&macro_release>,
                <&kp W &kp LCTRL>;

            label = "CTRL_W";
        };

        L_yamakakko: lyk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 20>,
                <&kp COMMA>,
                <&macro_release>,
                <&kp COMMA &kp LEFT_SHIFT>;

            label = "LYK";
        };

        R_yamakakko: Ryamak {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 20>,
                <&kp PERIOD>,
                <&macro_release>,
                <&kp PERIOD &kp LEFT_SHIFT>;

            label = "RYAMAK";
        };

        altesc: altesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_wait_time 20>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp RIGHT_ALT>;

            label = "ALTESC";
        };

        saltesc: saltesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp RIGHT_ALT &kp RSHIFT>;

            label = "SALTESC";
        };

        ctrlplus: ctrlplus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_wait_time 20>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LCTRL &kp LSHFT>;

            label = "CTRLPLUS";
        };

        syounari: syounari {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp RBKT>,
                <&macro_release>,
                <&kp RBKT &kp LEFT_SHIFT>;

            label = "SYOUNARI";
        };

        dainari: dainari {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp NUHS>,
                <&macro_release>,
                <&kp NUHS &kp LEFT_SHIFT>;

            label = "DAINARI";
        };

        stab: stab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp TAB>,
                <&macro_release>,
                <&kp TAB &kp LEFT_SHIFT>;

            label = "STAB";
        };

        larger: dai {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp PERIOD>,
                <&macro_release>,
                <&kp PERIOD &kp LEFT_SHIFT>;

            label = "DAI";
        };

        smaller: smaller {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 50>,
                <&kp COMMA>,
                <&macro_release>,
                <&kp COMMA &kp LEFT_SHIFT>;

            label = "SMALLER";
        };
    };

    behaviors {
        L_HRM: L_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 28 29 40 41 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        R_HRM: R_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "R_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 22 23 24 34 35 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        L_THUMB: L_THUMB {
            compatible = "zmk,behavior-hold-tap";
            label = "L_THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 28 29 40 41 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        R_THUMB: R_THUMB {
            compatible = "zmk,behavior-hold-tap";
            label = "R_THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 22 23 24 34 35 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        S_key: S_key {
            compatible = "zmk,behavior-sticky-key";
            label = "S_KEY";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <500>;
        };

        C_W: C_W {
            compatible = "zmk,behavior-caps-word";
            label = "C_W";
            #binding-cells = <0>;
            continue-list = <INT_YEN INT_RO>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        coron: coron {
            compatible = "zmk,behavior-mod-morph";
            label = "CORON";
            bindings = <&kp PERIOD>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };

        semicoron: semicoron {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMICORON";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };

        hussexc: hussexc {
            compatible = "zmk,behavior-mod-morph";
            label = "HUSSEXC";
            bindings = <&hush>, <&kp NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_RSFT)>;
        };

        MML_KAKKO: MML_KAKKO {
            compatible = "zmk,behavior-mod-morph";
            label = "MML_KAKKO";
            bindings = <&lk>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT)>;
        };

        MMR_KAKKO: MMR_KAKKO {
            compatible = "zmk,behavior-mod-morph";
            label = "MMR_KAKKO";
            bindings = <&rk>, <&kp PERIOD>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT)>;
        };

        YOKOBOU: YOKOBOU {
            compatible = "zmk,behavior-mod-morph";
            label = "YOKOBOU";
            bindings = <&kp MINUS>, <&kp INT1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT)>;
        };

        RMTwin: RMTwin {
            compatible = "zmk,behavior-hold-tap";
            label = "RMTWIN";
            bindings = <&kp>, <&YOKOBOU>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <1 2 3 4 10 11 12 13 14 22 23 24 34 35 0 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        L_LT: L_LT {
            compatible = "zmk,behavior-hold-tap";
            label = "L_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 28 29 40 41 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        R_LT: R_LT {
            compatible = "zmk,behavior-hold-tap";
            label = "R_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 22 23 24 34 35 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        athutt: athutt {
            compatible = "zmk,behavior-mod-morph";
            label = "ATHUTT";
            bindings = <&kp LBKT>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
        };

        AML_LS: AML_LS {
            compatible = "zmk,behavior-hold-tap";
            label = "AML_LS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
        };

        L_HRM_SP: L_HRM_SP {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM_SP";
            bindings = <&kp>, <&S_key>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 28 29 40 41 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        L_THUMB2: L_THUMB2 {
            compatible = "zmk,behavior-hold-tap";
            label = "L_THUMB2";
            bindings = <&kp>, <&calte>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 28 29 40 41 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        R_THUMB2: R_THUMB2 {
            compatible = "zmk,behavior-hold-tap";
            label = "R_THUMB2";
            bindings = <&kp>, <&evalue>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 22 23 24 34 35 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        L_THUMB3: L_THUMB3 {
            compatible = "zmk,behavior-hold-tap";
            label = "L_THUMB3";
            bindings = <&mo>, <&altesc>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 28 29 40 41 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        anpas: anpas {
            compatible = "zmk,behavior-mod-morph";
            label = "ANPAS";
            bindings = <&anp>, <&aster>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
        };

        uspl: uspl {
            compatible = "zmk,behavior-mod-morph";
            label = "USPL";
            bindings = <&us>, <&pl>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W            &kp E               &kp R                &kp T                                                                  &kp Y             &kp U           &kp I            &kp O               &kp P
&L_HRM LWIN A  &L_HRM LALT S    &L_HRM LCTRL D      &L_HRM LSHFT F       &kp G             &athutt                     &kp K_CONTEXT_MENU       &kp H             &R_HRM RSHFT J  &R_HRM RCTRL K   &R_HRM RIGHT_ALT L  &R_HRM RWIN MINUS
&kp Z          &kp X            &kp C               &kp V                &kp B             &hussexc                    &kp PRINTSCREEN          &kp N             &kp M           &AML_LS 2 COMMA  &kp PERIOD          &AML_LS 1 SLASH
&anpas         &kp PRINTSCREEN  &kp K_CONTEXT_MENU  &L_THUMB 3 LEFT_ALT  &L_THUMB 4 LCTRL  &L_THUMB2 LEFT_SHIFT 0      &R_THUMB2 RIGHT_SHIFT 0  &L_THUMB 2 SPACE                                                       &uspl
            >;

            sensor-bindings = <&inc_dec_kp A B>;
        };

        MOUSE {
            bindings = <
