                <&macro_wait_time 20>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp RIGHT_ALT>;

            label = "ALTESC";
        };

        saltesc: saltesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
