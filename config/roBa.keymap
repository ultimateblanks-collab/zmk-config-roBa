            label = "WINSHIFTS";
        };

        altprsc: altprsc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 50>,
                <&kp PRINTSCREEN>,
