            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp N9>,
                <&macro_release>,
                <&kp N9 &kp LSHFT>;

            label = "R_KAKKO";
        };

        us: us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp INTERNATIONAL_1>,
                <&macro_release>,
                <&kp INTERNATIONAL_1 &kp LSHFT>;

            label = "US";
        };

        pl: pl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp INTERNATIONAL_3>,
                <&macro_release>,
                <&kp INTERNATIONAL_3 &kp LSHFT>;

            label = "PL";
        };

        eql: eql {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp MINUS &kp LSHFT>;

            label = "EQL";
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp EQUAL>,
                <&macro_release>,
                <&kp EQUAL &kp LSHFT>;

            label = "TILDE";
        };

        plus: plus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LSHFT>;

            label = "PLUS";
        };

        aster: aster {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp SINGLE_QUOTE>,
                <&macro_release>,
                <&kp SINGLE_QUOTE &kp LSHFT>;

            label = "ASTER";
        };

        altesc: altesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp LEFT_ALT>;

            label = "ALTESC";
        };

        saltesc: saltesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT &kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp LEFT_ALT &kp LSHFT>;

            label = "SALTESC";
        };

        ctpgup: ctpgup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp PG_UP>,
                <&macro_release>,
                <&kp PG_UP &kp LCTRL>;

            label = "CTPGUP";
        };

        ctpgdn: pgdn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp PAGE_DOWN>,
                <&macro_release>,
                <&kp PAGE_DOWN &kp LCTRL>;

            label = "PGDN";
        };

        Lmid: Lmid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp RBKT>,
                <&macro_release>,
                <&kp RBKT &kp LSHFT>;

            label = "LMID";
        };

        Rmid: Rmid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp NUHS>,
                <&macro_release>,
                <&kp NUHS &kp LSHFT>;

            label = "RMID";
        };

        wintab: wintab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LWIN>,
                <&macro_wait_time 15>,
                <&kp TAB>,
                <&macro_release>,
                <&kp TAB &kp LWIN>;

            label = "WINTAB";
        };

        ctrlW: ctrlW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp W>,
                <&macro_release>,
                <&kp W &kp LCTRL>;

            label = "CTRLW";
        };

        altF4: altF4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp F4>,
                <&macro_release>,
                <&kp F4 &kp LEFT_ALT>;

            label = "ALTF4";
        };

        ctrlT: ctrlT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp T>,
                <&macro_release>,
                <&kp T &kp LCTRL>;

            label = "CTRLT";
        };

        carte: carte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp N3 &kp N7 &kp N0 &kp N8 &kp TAB>,
                <&macro_wait_time 10>,
                <&kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp N1 &kp N2 &kp N3 &kp ENTER>;

            label = "CARTE";
        };

        evalue: evalue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp N3 &kp N7 &kp N0 &kp N8 &kp TAB>,
                <&macro_wait_time 10>,
                <&kp N0 &kp N8 &kp N6 &kp N2 &kp ENTER>;

            label = "EVALUE";
        };

        altF3: altF3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 15>,
                <&kp F3>,
                <&macro_release>,
                <&kp F3 &kp LEFT_ALT>;

            label = "ALTF3";
        };

        altf11: altf11 {
