            compatible = "zmk,behavior-mod-morph";
            label = "ATHUTT";
            bindings = <&kp LBKT>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_RSFT|MOD_RALT|MOD_RGUI)>;
        };

        AML_LS: AML_LS {
            compatible = "zmk,behavior-hold-tap";
            label = "AML_LS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
        };

        L_HRM_SP: L_HRM_SP {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM_SP";
            bindings = <&kp>, <&S_key>;

            #binding-cells = <2>;
