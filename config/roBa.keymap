                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp END>,
                <&macro_release>,
                <&kp END &kp LCTRL>;

            label = "CTEND";
        };

        ctrlPLUS: ctrlPLUS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_wait_time 15>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LSHFT>;

            label = "CTRLPLUS";
        };

        ctrlMINUS: ctrlMINUS {
