        ctrlRIGHT: ctrlRIGHT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 15>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RIGHT &kp LCTRL>;

            label = "CTRLRIGHT";
